// Prisma Schema — AssembleIA (Com QR Code único na Carteirinha)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Congregacao {
  id                Int      @id @default(autoincrement())
  nome              String
  endereco          String?
  telefone          String?
  pastorResponsavel String?  @map("pastor_responsavel")
  dataCadastro      DateTime @default(now()) @map("data_cadastro")

  membros           Membro[]

  @@map("congregacoes")
}

model Membro {
  id              Int       @id @default(autoincrement())
  numeroMembro    String?   @unique @map("numero_membro")
  congregacaoId   Int?      @map("congregacao_id")
  congregacao     Congregacao? @relation(fields: [congregacaoId], references: [id])

  nomeCompleto    String    @map("nome_completo")
  dataNascimento  DateTime? @map("data_nascimento")
  sexo            String?
  estadoCivil     String?   @map("estado_civil")

  cpf             String?   @unique
  rg              String?
  telefone        String?
  whatsapp        String?
  email           String?

  endereco        String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  cep             String?
  foto            String?

  ativo           Int       @default(1)
  dataCadastro    DateTime  @default(now()) @map("data_cadastro")
  dataAtualizacao DateTime? @updatedAt @map("data_atualizacao")

  familiares      Familiar[]
  filhos          Filho[]
  vidaEspiritual  VidaEspiritual?
  observacoes     ObservacaoMembro?
  fotos           FotoMembro[]
  carteirinha     Carteirinha?
  membroMinisterios MembroMinisterio[]
  historico       HistoricoMembro[]

  @@index([nomeCompleto], map: "idx_membros_nome")
  @@index([cpf], map: "idx_membros_cpf")
  @@index([telefone], map: "idx_membros_telefone")
  @@index([congregacaoId], map: "idx_membros_congregacao")
  @@map("membros")
}

model Familiar {
  id          Int    @id @default(autoincrement())
  membroId    Int    @map("membro_id")
  membro      Membro @relation(fields: [membroId], references: [id], onDelete: Cascade)

  nomePai     String? @map("nome_pai")
  nomeMae     String? @map("nome_mae")
  nomeConjuge String? @map("nome_conjuge")

  @@map("familiares")
}

model Filho {
  id             Int       @id @default(autoincrement())
  membroId       Int       @map("membro_id")
  membro         Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)

  nome           String
  dataNascimento DateTime? @map("data_nascimento")
  idade          Int?

  @@index([membroId], map: "idx_filhos_membro")
  @@map("filhos")
}

model VidaEspiritual {
  id                   Int       @id @default(autoincrement())
  membroId             Int       @unique @map("membro_id")
  membro               Membro    @relation(fields: [membroId], references: [id], onDelete: Cascade)

  dataConversao        DateTime? @map("data_conversao")
  batizadoAguas        Int       @default(0) @map("batizado_aguas")
  dataBatismo          DateTime? @map("data_batismo")
  igrejaBatismo        String?   @map("igreja_batismo")
  batismoEspiritoSanto Int       @default(0) @map("batismo_espirito_santo")
  veioOutraIgreja      Int       @default(0) @map("veio_outra_igreja")
  igrejaAnterior       String?   @map("igreja_anterior")
  dataRecebimento      DateTime? @map("data_recebimento")

  @@map("vida_espiritual")
}

model Ministerio {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  descricao String?

  membros   MembroMinisterio[]

  @@map("ministerios")
}

model MembroMinisterio {
  id           Int        @id @default(autoincrement())
  membroId     Int        @map("membro_id")
  membro       Membro     @relation(fields: [membroId], references: [id], onDelete: Cascade)
  ministerioId Int        @map("ministerio_id")
  ministerio   Ministerio @relation(fields: [ministerioId], references: [id], onDelete: Cascade)

  dataInicio   DateTime?  @map("data_inicio")
  ativo        Int        @default(1)

  @@index([membroId], map: "idx_ministerio_membro")
  @@map("membro_ministerio")
}

model ObservacaoMembro {
  id                    Int    @id @default(autoincrement())
  membroId              Int    @unique @map("membro_id")
  membro                Membro @relation(fields: [membroId], references: [id], onDelete: Cascade)

  talentos              String?
  necessidadesEspeciais String? @map("necessidades_especiais")
  contatoEmergencia     String? @map("contato_emergencia")
  telefoneEmergencia    String? @map("telefone_emergencia")
  observacoes           String?

  @@map("observacoes_membro")
}

model FotoMembro {
  id        Int    @id @default(autoincrement())
  membroId  Int    @map("membro_id")
  membro    Membro @relation(fields: [membroId], references: [id], onDelete: Cascade)

  tipo      String @default("CARTEIRINHA") // CARTEIRINHA, BANNER
  arquivo   String
  caminho   String
  extensao  String @default("jpg")
  principal Int    @default(1)

  @@map("fotos_membros")
}

model Carteirinha {
  id          Int      @id @default(autoincrement())
  membroId    Int      @unique @map("membro_id")
  membro      Membro   @relation(fields: [membroId], references: [id], onDelete: Cascade)

  numero      String   @unique
  dataEmissao DateTime @default(now()) @map("data_emissao")
  validade    DateTime

  arquivo     String?
  qrCode      String?  @map("qr_code") // String base64 ou URL única do QR Code

  @@map("carteirinhas")
}

model StatusWhatsapp {
  id            Int      @id @default(autoincrement())
  titulo        String
  tipoMedia     String   @default("TEXTO")
  mediaUrl      String?  @map("media_url")
  legenda       String?
  dataAgendada  DateTime @map("data_agendada")
  recorrencia   String   @default("UNICA")
  frequenciaDia Int      @default(1) @map("frequencia_dia")
  diasSemana    String?  @map("dias_semana")
  status        String   @default("PENDENTE")
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@map("status_whatsapp")
}

model EscalaAgendada {
  id            Int      @id @default(autoincrement())
  departamento  String
  dataEscala    DateTime @map("data_escala")
  conteudo      String
  recorrencia   String   @default("SEMANAL")
  frequenciaDia Int      @default(1) @map("frequencia_dia")
  enviada       Int      @default(0)
  criadoEm      DateTime @default(now()) @map("criado_em")

  @@map("escalas_agendadas")
}

model SicrediConfig {
  id              Int      @id @default(autoincrement())
  cooperativa     String
  contaCorrente   String
  clientId        String   @map("client_id")
  clientSecret    String   @map("client_secret")
  environment     String   @default("SANDBOX")
  mtlsCertPem     String?  @map("mtls_cert_pem")
  mtlsKeyPem      String?  @map("mtls_key_pem")
  autoSyncEnabled Int      @default(1) @map("auto_sync_enabled")
  lastSyncAt      DateTime? @map("last_sync_at")
  createdEm       DateTime @default(now()) @map("created_em")

  @@map("sicredi_configs")
}

model BankTransaction {
  id              Int      @id @default(autoincrement())
  sicrediTxId     String   @unique @map("sicredi_tx_id")
  tipo            String
  categoria       String
  descricao       String
  valor           Float
  dataTransacao   DateTime @map("data_transacao")
  pagadorNome     String?  @map("pagador_nome")
  pagadorCpfCnpj  String?  @map("pagador_cpf_cnpj")
  saldoResultante Float?   @map("saldo_resultante")
  metodo          String   @default("PIX")
  rawJsonPayload  String?  @map("raw_json_payload")
  dataRegistro    DateTime @default(now()) @map("data_registro")

  @@index([tipo], map: "idx_bank_tx_tipo")
  @@index([dataTransacao], map: "idx_bank_tx_data")
  @@map("bank_transactions")
}

model SicrediWebhookLog {
  id              Int      @id @default(autoincrement())
  eventType       String   @map("event_type")
  payload         String
  processed       Int      @default(0)
  receivedAt      DateTime @default(now()) @map("received_at")

  @@map("sicredi_webhook_logs")
}

model Usuario {
  id        Int       @id @default(autoincrement())
  nome      String
  email     String    @unique
  senhaHash String    @map("senha_hash")
  perfil    String
  ativo     Int       @default(1)
  criadoEm  DateTime  @default(now()) @map("criado_em")

  historico HistoricoMembro[]

  @@map("usuarios")
}

model HistoricoMembro {
  id        Int      @id @default(autoincrement())
  membroId  Int      @map("membro_id")
  membro    Membro   @relation(fields: [membroId], references: [id])
  usuarioId Int?     @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  acao      String?
  descricao String?
  data      DateTime @default(now())

  @@map("historico_membros")
}
